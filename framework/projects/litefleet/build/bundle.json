   "firstLine": 130,
   "text": "func (e *Engine) Query(ctx context.Context, id string, epoch int, req wire.QueryRequest, start func() io.Writer) (started bool, err error) {\n\tdefer observeStatement(\"read\", time.Now())\n\tctx, cancel := context.WithTimeout(ctx, StatementDeadline)\n\tdefer cancel()\n\tif !isRead(req.SQL) {\n\t\treturn false, &StatementError{http.StatusBadRequest, \"bad_request\", \"query takes a single read statement; use execute for writes\"}\n\t}\n\th, err := e.Handle(id)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tdefer h.Release()\n\tif err := h.admit(epoch); err != nil {\n\t\treturn false, err\n\t}\n\trelease, err := e.acquire(ctx, h, false)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tdefer release()",
