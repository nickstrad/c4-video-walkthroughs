   "firstLine": 194,
   "text": "\tfor rows.Next() {\n\t\tif count == MaxRows {\n\t\t\ttruncated = true\n\t\t\tbreak\n\t\t}\n\t\tif err := rows.Scan(ptrs...); err != nil {\n\t\t\treturn true, classify(ctx, err)\n\t\t}\n\t\trow, err := json.Marshal(vals)\n\t\tif err != nil {\n\t\t\treturn true, err\n\t\t}\n\t\tif size+int64(len(row)) > MaxBytes {\n\t\t\ttruncated = true\n\t\t\tbreak\n\t\t}\n\t\tif count > 0 {\n\t\t\tw.Write([]byte{','})\n\t\t\tsize++\n\t\t}\n\t\tw.Write(row)\n\t\tsize += int64(len(row))\n\t\tcount++\n\t}",
