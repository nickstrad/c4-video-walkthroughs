     },
     {
      "id": "forward",
      "n": 5,
      "from": "gateway",
      "to": "node",
      "label": "Forwards query / execute with X-Epoch",
      "technology": "HTTP/JSON"
     },
     {
      "id": "sql-tenant",
      "n": 6,
      "from": "node",
      "to": "tenant-files",
      "label": "Executes SQL; snapshots; checkpoints",
      "technology": "SQLite / local file I/O"
     }
    ],
    "scenario": [
     {
      "id": "query-flow-step-1",
      "edge": "tenant-edge",
      "direction": "forward",
      "label": "Tenant sends a read (bearer API key)."
     },
     {
      "id": "query-flow-step-2",
      "edge": "balance",
      "direction": "forward",
      "label": "HAProxy selects a healthy gateway."
     },
     {
      "id": "query-flow-step-3",
      "edge": "resolve",
      "direction": "forward",
      "label": "Cache miss only: resolve key and database; a live cache hit skips this exchange."
     },
     {
      "id": "query-flow-step-4",
      "edge": "sql-registry",
      "direction": "forward",
      "label": "On remote lookup, control reads indexed registry."
     },
     {
      "id": "query-flow-step-5",
      "edge": "resolve",
      "direction": "reverse",
      "label": "Control returns route; gateway caches it."
     },
     {
      "id": "query-flow-step-6",
      "edge": "forward",
      "direction": "forward",
      "label": "Gateway posts query and epoch to owning node."
     },
     {
      "id": "query-flow-step-7",
      "edge": "sql-tenant",
      "direction": "forward",
      "label": "Node checks epoch, admits work and runs bounded read."
     },
     {
      "id": "query-flow-step-8",
      "edge": "forward",
      "direction": "reverse",
      "label": "Node streams capped rows; errors after start abort the stream."
     },
     {
      "id": "query-flow-step-9",
      "edge": "balance",
      "direction": "reverse",
      "label": "Gateway transcodes rows through HAProxy."
     },
     {
      "id": "query-flow-step-10",
      "edge": "tenant-edge",
      "direction": "reverse",
      "label": "Tenant receives rows and truncated flag, or an error / incomplete stream."
     }
    ]
   },
