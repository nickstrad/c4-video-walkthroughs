{
  "name": "@c4v/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared core: storyboard schema, narration timeline, pinned code excerpts, C4 view data. Run with Node >= 22.18 (native type stripping).",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build:litefleet": "node bin/c4v.ts build ../projects/litefleet",
    "verify:litefleet": "node bin/c4v.ts verify ../projects/litefleet",
    "proof:litefleet": "node bin/c4v.ts proof ../projects/litefleet"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3"
  }
}
